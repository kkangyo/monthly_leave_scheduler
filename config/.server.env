# NodeJS
# Express listens on PORT with no host argument, which binds all network interfaces
# (0.0.0.0) by default, so it's already reachable from outside localhost.
PORT=8000

# for accessing from Nodejs to MySQL
DB_HOST="db"
DB_USER="root"
DB_PSWORD="password"
DB_DATABASE="leave_schedule"
DB_PORT=3306

# 로그인 토큰(JWT) 서명 키. 운영 배포 전에 반드시 무작위 값으로 교체할 것
# (예: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET="CHANGE_ME_dev_only_jwt_secret"

# 슈퍼관리자(개발자) 계정 — 매장 생성/삭제 등 플랫폼 레벨 작업 전용, DB 테이블 없이 env 로만 관리.
# 비밀번호는 평문이 아니라 bcrypt 해시로 저장한다. 해시 생성:
#   node -e "console.log(require('bcryptjs').hashSync('새비밀번호', 10))"
# 아래 해시는 개발용 비밀번호 "admin" 의 해시 — 운영 전에 반드시 교체할 것.
# 해시에 '$'가 들어있어서 반드시 작은따옴표로 감싸야 한다(큰따옴표면 docker-compose 가 $변수로 치환해버림).
SUPERADMIN_LOGIN_ID="superadmin"
SUPERADMIN_PASSWORD_HASH='$2b$10$3nSHmzIuubKyZi8Jm6ppWeht0FVoww4LDsPkicjsxWdAqAgdWEY/O'

# 최초 마이그레이션 때 기존(테스트) 매장 데이터를 백필할 store_code. 이후 로그인 시 이 코드로 접속.
DEFAULT_STORE_CODE="default"